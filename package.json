{
  "name": "frontend_insight",
  "version": "1.0.0",
  "description": "Nextcloud app to capture and analyze client-side JavaScript errors",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "run-p build:*",
    "build:event-browser": "vite build",
    "build:client": "esbuild src/client/index.ts --bundle --outfile=js/client.js",
    "extract-translations": "node bin/extract_translations.cjs",
    "test": "./bin/e2e-local.sh --use-existing",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@svar-ui/svelte-core": "2.6.0",
    "@svar-ui/svelte-grid": "2.7.1",
    "@types/node": "24.13.2",
    "esbuild": "0.28.1",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.16",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vite-plugin-css-injected-by-js": "3.5.2",
    "vite-plugin-html": "3.2.2"
  },
  "dependencies": {
    "@nextcloud/axios": "2.6.0",
    "@nextcloud/initial-state": "3.0.0",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/router": "3.1.0",
    "@nextcloud/typings": "1.10.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4"
  }
}
